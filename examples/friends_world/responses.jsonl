# --- friend-a: Terry --------------------------------------------------------------------------
# His own pool. Owned templates come before the wildcard ones in `_candidates`, so these replace
# the neutral lines entirely for him -- friend-b and friend-c are untouched.
#
# Typed, not written. Lower case, contractions, no full stops on short lines, and the odd dropped
# apostrophe (handled by `reply/style.py`, not by hand). The register is a big warm guy in his
# fifties texting from the workshop: short bursts, "ya", "bud", no essay cadences. The firmness is
# aimed at the world; every line is warm to the person being answered.
{"id": "r-a-greeting-1", "character": "friend-a", "tags": ["social:greeting"], "template": "hey hey, good to see ya {speaker}"}
{"id": "r-a-greeting-2", "character": "friend-a", "tags": ["social:greeting"], "template": "there he is. come on in"}
{"id": "r-a-greeting-3", "character": "friend-a", "tags": ["social:greeting"], "template": "yo. now the day's looking up"}
{"id": "r-a-greeting-4", "character": "friend-a", "tags": ["social:greeting"], "template": "evening. sit down, tell me what's new"}
{"id": "r-a-greeting-5", "character": "friend-a", "tags": ["social:greeting"], "template": "morning. coffee's hot, ice is cold, what do you need"}
{"id": "r-a-greeting-6", "character": "friend-a", "tags": ["social:greeting"], "template": "ah, {speaker}. just the guy i wanted to see"}
{"id": "r-a-presence-1", "character": "friend-a", "tags": ["social:presence"], "template": "i'm here. been here, will be here, what do you need"}
{"id": "r-a-presence-2", "character": "friend-a", "tags": ["social:presence"], "template": "yep, right here {speaker}. pull up a chair"}
{"id": "r-a-presence-3", "character": "friend-a", "tags": ["social:presence"], "template": "always. you're not rid of me that easy"}
{"id": "r-a-presence-4", "character": "friend-a", "tags": ["social:presence"], "template": "present and accounted for"}
{"id": "r-a-presence-5", "character": "friend-a", "tags": ["social:presence"], "template": "i'm around. say the word"}
{"id": "r-a-howareyou-1", "character": "friend-a", "tags": ["social:howareyou"], "template": "better than i deserve and twice as loud, you?"}
{"id": "r-a-howareyou-2", "character": "friend-a", "tags": ["social:howareyou"], "template": "can't complain, and i've tried. how about you {speaker}"}
{"id": "r-a-howareyou-3", "character": "friend-a", "tags": ["social:howareyou"], "template": "strong as an ox and twice as stubborn. you?"}
{"id": "r-a-howareyou-4", "character": "friend-a", "tags": ["social:howareyou"], "template": "good. real good. what's on your mind"}
{"id": "r-a-howareyou-5", "character": "friend-a", "tags": ["social:howareyou"], "template": "living the dream. my dream, mind you, but a good one"}
{"id": "r-a-thanks-1", "character": "friend-a", "tags": ["social:thanks"], "template": "any time"}
{"id": "r-a-thanks-2", "character": "friend-a", "tags": ["social:thanks"], "template": "don't mention it, you'd do the same for me"}
{"id": "r-a-thanks-3", "character": "friend-a", "tags": ["social:thanks"], "template": "hah. no thanks needed, just pay it forward"}
{"id": "r-a-thanks-4", "character": "friend-a", "tags": ["social:thanks"], "template": "you're welcome. now go do something good with it"}
{"id": "r-a-thanks-5", "character": "friend-a", "tags": ["social:thanks"], "template": "glad to help, seriously"}
{"id": "r-a-goodbye-1", "character": "friend-a", "tags": ["social:goodbye"], "template": "go on then, get some rest"}
{"id": "r-a-goodbye-2", "character": "friend-a", "tags": ["social:goodbye"], "template": "night {speaker}. you did good today"}
{"id": "r-a-goodbye-3", "character": "friend-a", "tags": ["social:goodbye"], "template": "see ya. look after yourself"}
{"id": "r-a-goodbye-4", "character": "friend-a", "tags": ["social:goodbye"], "template": "off you go, i'll be here"}
{"id": "r-a-goodbye-5", "character": "friend-a", "tags": ["social:goodbye"], "template": "take care of yourself, and be good to your people"}
{"id": "r-a-apology-1", "character": "friend-a", "tags": ["social:apology"], "template": "forget it. already forgotten"}
{"id": "r-a-apology-2", "character": "friend-a", "tags": ["social:apology"], "template": "don't give it another thought, we're square"}
{"id": "r-a-apology-3", "character": "friend-a", "tags": ["social:apology"], "template": "no harm done. happens to the best of us"}
{"id": "r-a-apology-4", "character": "friend-a", "tags": ["social:apology"], "template": "water under the bridge {speaker}"}
{"id": "r-a-apology-5", "character": "friend-a", "tags": ["social:apology"], "template": "it's fine, truly"}
{"id": "r-a-agreement-1", "character": "friend-a", "tags": ["social:agreement"], "template": "now you're talking. that's the right call"}
{"id": "r-a-agreement-2", "character": "friend-a", "tags": ["social:agreement"], "template": "damn right. let's move"}
