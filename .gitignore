# Virtual environments
.venv/
venv/

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Editors
.vscode/
.idea/

# --- Datasets -----------------------------------------------------------------
# Nothing downloaded or generated belongs in git: corpora run to tens or hundreds
# of megabytes, they slow every clone and every status call, and they are all
# reproducible from a URL (docs/CLASSIFIER.md §5).
#
# Two folders, different jobs:
#   corpora/  downloaded or hand-built source data, plus what is derived from it
#   data/     this install's runtime state: characters, seats, bots.json, logs
#
# Only examples/ (the tiny demo and friends worlds) and tests/fixtures/ are tracked.
# corpora/ keeps one tracked file, its README, so the folder exists and explains
# itself in a fresh clone; everything else inside it is ignored.
corpora/*
!corpora/README.md
data/
datasets/     # legacy alias from before corpora/; kept so an old checkout cannot leak in
*.jsonl.gz
custom_assets/

# Model weights (voices, ASR models) belong in the cache or a mounted volume.
models/
*.onnx
*.onnx.json

# Real credentials belong in the process environment or in a *_FILE secret
# mount (Docker secrets, systemd LoadCredential). A local .env is a plain-text
# development convenience only; it is read when no environment variable is set
# and must never be committed. Only .env.example is tracked.
.env
.env.*
!.env.example
*.env
secrets/
*.secret
*.token
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials*.json
*creds*.json
*credentials*.json
*secret*.json
service-account*.json
