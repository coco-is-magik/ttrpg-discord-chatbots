# Virtual environments
.venv/
venv/

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Editors
.vscode/
.idea/

# --- Datasets -----------------------------------------------------------------
# The real knowledge / in-character response corpora are large and machine
# produced, so they live outside git. Only examples/ (tiny demo world) and
# tests/fixtures/ are tracked; point --data at data/ on a deployed box.
data/
datasets/
*.jsonl.gz
custom_assets/

# Downloaded corpora, and anything derived from them, are regenerated locally rather
# than shipped: they run to tens or hundreds of megabytes and most carry licences that
# forbid redistribution. corpora/ keeps one tracked file, its README, so the folder
# exists in a fresh clone and explains itself.
#
# This rule was removed by accident in b04ca1c, which also committed the 36 MB
# Switchboard corpus. Do not `git add -f` anything in here; if `git status` ever lists
# a corpus file, this rule has been lost again.
corpora/*
!corpora/README.md

# Model weights (voices, ASR models) belong in the cache or a mounted volume.
models/
*.onnx
*.onnx.json

# Real credentials belong in the process environment or in a *_FILE secret
# mount (Docker secrets, systemd LoadCredential). A local .env is a plain-text
# development convenience only; it is read when no environment variable is set
# and must never be committed. Only .env.example is tracked.
.env
.env.*
!.env.example
*.env
secrets/
*.secret
*.token
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials*.json
*creds*.json
*credentials*.json
*secret*.json
service-account*.json
