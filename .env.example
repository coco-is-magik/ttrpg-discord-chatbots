# Template for local development. Copy it and keep the copy out of git:
#
#     cp .env.example .env
#     chmod 600 .env
#
# .env is git-ignored and is only a fallback: a real environment variable always
# wins over it. For deployments use the environment or DISCORD_TOKEN_FILE.

# Discord developer portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Optional. When set, the token is read from this file and DISCORD_TOKEN is
# ignored. Use it for Docker secrets (/run/secrets/...) or systemd credentials.
# DISCORD_TOKEN_FILE=/run/secrets/discord_token

# Optional. Guild (server) id to sync slash commands to. Guild sync is instant;
# leave it empty to sync globally, which can take up to an hour to show up.
DISCORD_GUILD_ID=
