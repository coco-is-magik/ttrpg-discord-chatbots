# Template for local development. Copy it and keep the copy out of git:
#
#     cp .env.example .env
#     chmod 600 .env
#
# .env is git-ignored and is only a fallback: a real environment variable always
# wins over it. For deployments use the environment or DISCORD_TOKEN_FILE.

# Discord developer portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Optional. When set, the token is read from this file and DISCORD_TOKEN is
# ignored. Use it for Docker secrets (/run/secrets/...) or systemd credentials.
# DISCORD_TOKEN_FILE=/run/secrets/discord_token

# Optional. Guild (server) id to sync slash commands to. Guild sync is instant;
# leave it empty to sync globally, which can take up to an hour to show up.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Language model (optional).
#
# With nothing here the bot tries a local text-generation-webui server on
# http://127.0.0.1:5000/v1 and falls back to the compression classifier if it is
# not running. A real environment variable always wins over this file.
# ---------------------------------------------------------------------------

# local | openai | clinepass | auto | off   (auto = keyed backend first, else local)
# TTRPG_LLM_BACKEND=local

# Move the local server, or point at another machine entirely.
# TTRPG_LLM_PORT=5000
# TTRPG_LLM_BASE_URL=http://127.0.0.1:5000/v1
# TTRPG_LLM_MODEL=local-model

# chat = Chat Completions, responses = the OpenAI Responses API (Codex models).
# TTRPG_LLM_WIRE=chat

# Keys. For deployments prefer the *_FILE form (Docker secrets, systemd
# LoadCredential) so the key is never in the environment or a shell history.
# OPENAI_API_KEY=your-key-here
# CLINE_API_KEY=your-key-here
# TTRPG_LLM_API_KEY_FILE=/run/secrets/llm_api_key

# TTRPG_LLM_TIMEOUT=30
# TTRPG_LLM_MAX_TOKENS=300
# TTRPG_LLM_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# The friends (optional).
#
# Discord applications are listed in data/bots.json (see examples/bots.example.json).
# The helper keeps DISCORD_TOKEN; every friend has its own token. A friend with no
# token is not an error: it is *dormant*, reported by --check and simply not started.
#
# One application per person. Each needs Message Content enabled in the portal before
# "listen": true is set, or Discord refuses the connection with close code 4014.
# ---------------------------------------------------------------------------

# TTRPG_BOTS_FILE=data/bots.json

# TTRPG_FRIEND_A_TOKEN=
# TTRPG_FRIEND_B_TOKEN=
# TTRPG_FRIEND_C_TOKEN=

# For deployments, prefer the file forms so the tokens never enter the environment.
# TTRPG_FRIEND_A_TOKEN_FILE=/run/secrets/friend_a_token
# TTRPG_FRIEND_B_TOKEN_FILE=/run/secrets/friend_b_token
# TTRPG_FRIEND_C_TOKEN_FILE=/run/secrets/friend_c_token

# Alternatively, give each friend its own dotenv file and point bots.json at it:
#   { "id": "friend-a", "role": "friend", "listen": true, "env_file": ".env.frienda" }
# Such a file may name its token DISCORD_TOKEN, exactly like the helper's: it is read on its
# own with dotenv_values, never merged into this environment, so the values cannot collide.

# Which phase of the conversation ladder answers real traffic. Unset means the old classifier
# answers everything.
#   greet  -- greetings only, every other message to the old path (the first thing that was proved)
#   ladder -- every phase a friend has a phrasebook for, and subject questions through
#             decide/subject. The old compression classifier is only reached when this is unset
# TTRPG_CONVERSATION=ladder

# Diagnostic only, and never for production: log every delivered message before any filtering
# (proves the gateway is sending events), and treat bot-authored messages as people (lets a probe
# exercise the whole path without a human). See docs/MANUAL_TESTING.md §2.6.
# TTRPG_LISTEN_TRACE=1
# TTRPG_TRUST_BOTS=1

# Where a friend's memory lives. One SQLite database for every friend, not one JSON file each: the
# file was rewritten whole on every save, up to four times per message. See docs/STORAGE.md.
# TTRPG_MEMORY_DB=data/memory.db
# Rollback journal (default) is the safe choice on NFS; WAL is faster on a local disk.
# TTRPG_MEMORY_JOURNAL=WAL

# Where the friends' lives, schedules and phrasebooks live.
# TTRPG_FRIENDS_DATA=examples/friends_world

# The classifier's act-transition table. Unset means "the table beside the dataset"
# (examples/friends_world/transitions.json, which is hand-authored). Point it at a table
# imported from Switchboard to use measured counts instead -- see docs/CLASSIFIER.md.
# Imported tables are not committed: the corpus licence is CC BY-NC-SA, and corpora/ is
# git-ignored (corpora/README.md has the download and import commands).
# TTRPG_FRIENDS_TRANSITIONS=corpora/switchboard/transitions.json


# The friends talking to each other, unprompted. Off unless set; see docs/AMBIENT.md.
# TTRPG_CHATTER=1
# TTRPG_CHATTER_CHANNEL=1364544268609523765
# Set to 0 to talk through the night. A dataset needs messages, and a night is eight hours of data.
# TTRPG_CHATTER_SLEEP=0
# Where the transcript goes. One jsonl line per thing said, plus a header describing the run.
# TTRPG_CHATTER_LOG=data/chatter.jsonl
